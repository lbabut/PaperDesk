[Unit]
Description=PaperDesk Apps production website
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/PaperDesk
ExecStart=/usr/bin/python3 /home/azureuser/PaperDesk/website/server.py --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
UMask=0027

[Install]
WantedBy=multi-user.target
